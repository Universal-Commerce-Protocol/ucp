{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucp.dev/schemas/common/types/color.json",
  "title": "Color",
  "description": "An sRGB color as a six-digit hex string (`#RRGGBB`), case-insensitive.",
  "type": "string",
  "pattern": "^#[0-9A-Fa-f]{6}$",
  "examples": [
    "#1A3C57",
    "#FFFFFF"
  ]
}
