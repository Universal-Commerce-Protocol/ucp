{
  "name": "ucp-ask-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Ask AI backend for ucp.dev: retrieval over the docs index plus a cost-capped call to your own model, deployed as a Cloudflare Worker.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "node --import tsx eval/run.ts",
    "embeddings": "node --import tsx scripts/build-embeddings.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22"
  }
}
