{
  "id": "V07-fence-establishes-authoritative-negative",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Only the explicit fence POST yields an authoritative non-commit",
  "spec_refs": [
    "Authoritative reconciliation",
    "Fence operation"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "read-only lookup of an unclaimed key",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/lookup?operation=cancel",
        "authenticated_platform": "platform-a",
        "headers": {
          "Original-Idempotency-Key": "9a7c2e10-0b5f-4d63-8e21-c4f6a1d93b08",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "lookups/unresolved_admission_in_flight.json"
      }
    },
    {
      "name": "Platform decides to abandon the original: POST fence with its OWN fresh Idempotency-Key",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications/fence",
        "authenticated_platform": "platform-a",
        "headers": {
          "Idempotency-Key": "3b1e8a54-6c0d-4e0a-9f7a-1d2c5b8e4a77",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/fence_cancel_key.json",
        "body_note": "body names original_idempotency_key=9a7c2e10-0b5f-4d63-8e21-c4f6a1d93b08"
      },
      "response": {
        "http_status": 200,
        "body_ref": "fences/fenced.json"
      }
    },
    {
      "name": "Platform re-reads the Order and submits a replacement under a NEW key",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "time passes beyond retained_until and the replay-cache window",
      "event": "clock_advance_beyond_all_retention"
    },
    {
      "name": "delayed ORIGINAL request (key K3) finally arrives",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "9a7c2e10-0b5f-4d63-8e21-c4f6a1d93b08",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 200,
        "body_ref": "errors/invalid_modification_request.json"
      }
    }
  ],
  "assertions": [
    "The permanent tombstone rejects the delayed original at any time: no record, no commit.",
    "Only the replacement attempt exists; the original can never commit, even after record and replay lifetimes lapse.",
    "A Business that cannot keep the tombstone for as long as the Order can accept modifications rejects the fence with fence_not_supported and the Platform stays unresolved.",
    "The Business chooses the rejection code for the late original; shown as invalid_modification_request provisionally."
  ]
}
