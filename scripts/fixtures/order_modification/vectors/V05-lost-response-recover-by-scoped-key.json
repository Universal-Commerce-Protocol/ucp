{
  "id": "V05-lost-response-recover-by-scoped-key",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Lost POST response recovered by scoped key lookup",
  "spec_refs": [
    "Authoritative reconciliation",
    "Scoped lookup"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "POST, response lost in transit",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      },
      "client_receives_response": false
    },
    {
      "name": "lookup by operation + original key",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/lookup?operation=cancel",
        "authenticated_platform": "platform-a",
        "headers": {
          "Original-Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "lookups/found.json"
      }
    }
  ],
  "assertions": [
    "Lookup scope is (authenticated Platform, Order ID, operation, original key).",
    "The key travels in Original-Idempotency-Key, not in the URL.",
    "The lookup request is not idempotency-cached and carries no Idempotency-Key."
  ]
}
