{
  "id": "V15-indeterminate-resolves",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "indeterminate resolves through authoritative status",
  "spec_refs": [
    "Outcomes"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "initial result",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/indeterminate.json"
      }
    },
    {
      "name": "later authoritative read, same modification_id",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/mod_51i",
        "headers": {
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "responses/indeterminate_resolved_committed.json"
      }
    }
  ],
  "assertions": [
    "indeterminate resolves only to committed or failed.",
    "modification_id and base_order_version are unchanged; status moves open to closed."
  ]
}
