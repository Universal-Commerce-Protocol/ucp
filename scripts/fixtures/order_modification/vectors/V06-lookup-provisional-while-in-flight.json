{
  "id": "V06-lookup-provisional-while-in-flight",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Missing lookup stays provisional; no new-key retry",
  "spec_refs": [
    "Authoritative reconciliation"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "lookup while the original submission may still be admitted",
      "state": "original_submission_in_flight",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/lookup?operation=cancel",
        "authenticated_platform": "platform-a",
        "headers": {
          "Original-Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "lookups/unresolved_admission_in_flight.json"
      }
    },
    {
      "name": "Platform replays ORIGINAL request: same key, identical bytes",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json",
        "raw_body": "identical"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    }
  ],
  "assertions": [
    "status unresolved MUST NOT be reported as an authoritative no-commit.",
    "The Platform MUST NOT create a replacement attempt with a fresh Idempotency-Key.",
    "Same-key identical-bytes replay is the safe recovery path while the deduplication guarantee holds."
  ]
}
