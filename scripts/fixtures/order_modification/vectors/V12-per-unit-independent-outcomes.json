{
  "id": "V12-per-unit-independent-outcomes",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "per_unit attempts yield independent per-unit outcomes",
  "spec_refs": [
    "Atomicity"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "submit four units",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_two_units.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/per_unit_mixed.json"
      }
    }
  ],
  "assertions": [
    "Eligible units are evaluated independently.",
    "A failed or refused unit never turns request-wide into success.",
    "not_attempted names its blocker in blocked_by."
  ]
}
