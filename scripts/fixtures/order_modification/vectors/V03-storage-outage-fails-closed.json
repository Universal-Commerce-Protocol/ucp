{
  "id": "V03-storage-outage-fails-closed",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Idempotency storage failure fails closed",
  "spec_refs": [
    "Idempotency and replay"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "submission while replay store is unavailable",
      "fault": "replay_store_unavailable",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "3b1e8a54-6c0d-4e0a-9f7a-1d2c5b8e4a77",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 503,
        "body": {
          "code": "service_unavailable",
          "content": "Idempotency storage unavailable."
        },
        "headers": {
          "Retry-After": "5"
        }
      }
    }
  ],
  "assertions": [
    "Nothing is admitted or executed.",
    "A later same-key retry once storage recovers is processed as a first request, because no record exists."
  ]
}
