{
  "id": "V14-concurrent-same-unit",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Conflicting concurrent cancellations cannot both commit",
  "spec_refs": [
    "Concurrency"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "platform A and platform B submit cancel of unit_goods_2 concurrently",
      "concurrent": [
        {
          "transport": "rest",
          "method": "POST",
          "path": "/orders/ord_9f2/modifications",
          "headers": {
            "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
            "Content-Type": "application/json",
            "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
          },
          "body_ref": "requests/cancel_unit.json"
        },
        {
          "transport": "rest",
          "method": "POST",
          "path": "/orders/ord_9f2/modifications",
          "headers": {
            "Idempotency-Key": "3b1e8a54-6c0d-4e0a-9f7a-1d2c5b8e4a77",
            "Content-Type": "application/json",
            "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
          },
          "body_ref": "requests/cancel_unit.json"
        }
      ],
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "later read of the losing attempt",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/mod_51k",
        "headers": {
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "responses/refused_conflicting_modification.json"
      }
    }
  ],
  "assertions": [
    "The Business serializes commits in the Order's order_version sequence.",
    "The first commit wins; the second revalidates and resolves refused (reason_code conflicting_modification or unit_unavailable).",
    "The Order never shows the unit cancelled twice."
  ]
}
