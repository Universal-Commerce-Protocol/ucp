{
  "id": "V08-no-new-key-retry-without-resolution",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Platform keeps an unresolved attempt unresolved",
  "spec_refs": [
    "Authoritative reconciliation"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "lookup unresolved after deduplication guarantee lapsed",
      "state": "record_expired",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/lookup?operation=cancel",
        "authenticated_platform": "platform-a",
        "headers": {
          "Original-Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "lookups/unresolved_admission_in_flight.json"
      }
    }
  ],
  "assertions": [
    "Replay MUST NOT be assumed safe merely because 24 hours elapsed.",
    "With neither an authoritative outcome nor a guaranteed non-commit, the Platform MUST keep the result unresolved and MUST NOT submit a new-key attempt.",
    "Escalate to the buyer via the Order permalink_url instead."
  ]
}
