{
  "id": "V13-item-shipped-during-review",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Eligibility is revalidated at commit time",
  "spec_refs": [
    "Version preconditions"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "admitted for review",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "unit ships while awaiting decision",
      "event": "unit_shipped"
    },
    {
      "name": "Business approves; commit-time revalidation fails",
      "request": {
        "transport": "rest",
        "method": "GET",
        "path": "/orders/ord_9f2/modifications/mod_51a",
        "headers": {
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"ucp-agent\" \"original-idempotency-key\")"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "responses/refused_stale_eligibility.json"
      }
    }
  ],
  "assertions": [
    "The attempt resolves to refused with reason_code stale_eligibility.",
    "No cancellation commits against stale eligibility."
  ]
}
