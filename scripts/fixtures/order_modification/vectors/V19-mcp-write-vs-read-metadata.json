{
  "id": "V19-mcp-write-vs-read-metadata",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "MCP: only the mutation carries meta idempotency-key",
  "spec_refs": [
    "MCP binding"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "create_modification",
      "request": {
        "transport": "mcp",
        "tool": "create_modification",
        "meta": {
          "ucp-agent": {
            "profile": "https://platform.example/.well-known/ucp"
          },
          "idempotency-key": "f5d9d412-537c-4f4c-a9da-42a87e766f34"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 200,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "get_modification (read; no idempotency-key)",
      "request": {
        "transport": "mcp",
        "tool": "get_modification",
        "meta": {
          "ucp-agent": {
            "profile": "https://platform.example/.well-known/ucp"
          }
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "fence_modification (state-changing; own idempotency-key in meta, original key is an argument)",
      "request": {
        "transport": "mcp",
        "tool": "fence_modification",
        "meta": {
          "ucp-agent": {
            "profile": "https://platform.example/.well-known/ucp"
          },
          "idempotency-key": "3b1e8a54-6c0d-4e0a-9f7a-1d2c5b8e4a77"
        },
        "arguments": {
          "id": "ord_9f2",
          "operation": "cancel",
          "original_idempotency_key": "f5d9d412-537c-4f4c-a9da-42a87e766f34"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "fences/found_claimed.json"
      }
    },
    {
      "name": "lookup_modification (read; original key is an argument, not meta)",
      "request": {
        "transport": "mcp",
        "tool": "lookup_modification",
        "meta": {
          "ucp-agent": {
            "profile": "https://platform.example/.well-known/ucp"
          }
        },
        "arguments": {
          "id": "ord_9f2",
          "operation": "cancel",
          "original_idempotency_key": "f5d9d412-537c-4f4c-a9da-42a87e766f34"
        }
      },
      "response": {
        "http_status": 200,
        "body_ref": "lookups/found.json"
      }
    }
  ],
  "assertions": [
    "All MCP tool calls are JSON-RPC POSTs, but only create_modification is state-changing.",
    "Reads MUST NOT be stored as idempotent mutations."
  ]
}
