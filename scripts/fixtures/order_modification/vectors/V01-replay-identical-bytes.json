{
  "id": "V01-replay-identical-bytes",
  "kind": "runtime_conformance_vector",
  "executed_against_runtime": false,
  "title": "Same key + identical bytes replays the original response",
  "spec_refs": [
    "Idempotency and replay"
  ],
  "setup": {
    "order": "orders/order_by_unit_merchant_review.json",
    "authenticated_platform": "platform-a"
  },
  "steps": [
    {
      "name": "first submission",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    },
    {
      "name": "byte-identical retry",
      "request": {
        "transport": "rest",
        "method": "POST",
        "path": "/orders/ord_9f2/modifications",
        "headers": {
          "Idempotency-Key": "f5d9d412-537c-4f4c-a9da-42a87e766f34",
          "Content-Type": "application/json",
          "Signature-Input": "sig1=(\"@method\" \"@authority\" \"@path\" \"ucp-agent\" \"idempotency-key\" \"content-digest\" \"content-type\")"
        },
        "body_ref": "requests/cancel_unit.json",
        "raw_body": "identical"
      },
      "response": {
        "http_status": 201,
        "body_ref": "responses/pending.json"
      }
    }
  ],
  "assertions": [
    "Exactly one modification record exists after both steps.",
    "The retry response is the original response; no re-execution occurs.",
    "A cached replay is not a substitute for GET of the modification."
  ]
}
